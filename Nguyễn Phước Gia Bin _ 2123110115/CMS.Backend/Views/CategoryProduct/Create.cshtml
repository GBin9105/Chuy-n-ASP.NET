@model CMS.Data.Entities.CategoryProduct
@{
    ViewData["Title"] = "Thêm Danh Mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; // Khai báo Layout Admin ở đây
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-white border-bottom pt-4 pb-3">
            <h4 class="font-weight-bold text-uppercase mb-0">Thêm Danh Mục Mới</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="form-group mb-3">
                    <label class="font-weight-bold">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="VD: Máy khoan pin Milwaukee, DeWalt..." required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả cho danh mục này..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary mr-3">
                        <i class="fa-solid fa-arrow-left mr-2"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success px-4 font-weight-bold">
                        <i class="fa-solid fa-floppy-disk mr-2"></i> Lưu Danh Mục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}