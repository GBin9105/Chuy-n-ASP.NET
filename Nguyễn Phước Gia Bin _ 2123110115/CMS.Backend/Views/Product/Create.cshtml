@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Thêm mới Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid mt-4">
    <h2>Thêm Sản Phẩm Mới</h2>
    <hr />
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="mt-3" style="max-width: 800px;">
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm (VD: Máy khoan pin Milwaukee, DeWalt...)" required />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                <input asp-for="Price" type="number" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho</label>
                <input asp-for="StockQuantity" type="number" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryProductId" class="form-label fw-bold">Danh mục</label>
            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.Categories" required>
                <option value="">-- Chọn danh mục sản phẩm --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Chọn Hình ảnh từ thiết bị</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
            <input type="hidden" asp-for="ImageUrl" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-success fw-bold">Thêm mới</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy & Quay lại</a>
    </form>
</div>