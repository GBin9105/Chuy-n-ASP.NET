@model CMS.Data.Entities.Product
@{
    ViewData["Title"] = "Chỉnh sửa Sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid mt-4">
    <h2>Chỉnh sửa Thông tin Sản phẩm</h2>
    <hr />
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-3" style="max-width: 800px;">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ)</label>
                <input asp-for="Price" type="number" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho</label>
                <input asp-for="StockQuantity" type="number" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryProductId" class="form-label fw-bold">Danh mục</label>
            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.Categories" required></select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Thay đổi Hình ảnh (Bỏ trống nếu muốn giữ ảnh cũ)</label>

            <input type="file" name="imageFile" class="form-control" accept="image/*" />

            <input type="hidden" asp-for="ImageUrl" />

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mt-2">
                    <p class="mb-1 text-muted">Ảnh hiện tại:</p>
                    <img src="@Model.ImageUrl" alt="Hình ảnh hiện tại" style="height: 100px; border-radius: 5px; border: 1px solid #ccc; padding: 3px;" />
                </div>
            }
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">Mô tả sản phẩm</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-warning fw-bold">Cập nhật thay đổi</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy & Quay lại</a>
    </form>
</div>