@model IEnumerable<CMS.Data.Entities.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm Power Tools";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid mt-4">
    <h2>Danh sách Máy & Dụng cụ</h2>
    <a href="/Product/Create" class="btn btn-primary mb-3">Thêm sản phẩm mới (Milwaukee, DeWalt...)</a>

    <table class="table table-bordered table-striped text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá bán</th>
                <th>Tồn kho</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;" />
                            }
                            else
                            {
                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </td>
                        <td class="text-start">@item.Name</td>
                        <td class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</td>
                        <td>
                            <span class="badge bg-info text-dark" style="font-size: 14px;">@item.StockQuantity</span>
                        </td>
                        <td>
                            <a href="/Product/Edit/@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                            <a href="/Product/Delete/@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-muted py-4">Chưa có sản phẩm nào trong cơ sở dữ liệu. Hãy thêm mới!</td>
                </tr>
            }
        </tbody>
    </table>
</div>