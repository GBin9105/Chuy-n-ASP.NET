@model IEnumerable<CMS.Data.Entities.Post>
@{
    ViewData["Title"] = "Quản Lý Bafi";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="container-fluid mt-4">
    <!-- Tiêu đề và nút thêm mới -->
    <div class="mb-4">
        <h2 class="font-weight-bold">Danh sách Bài viết</h2>
        <a asp-action="Create" class="btn btn-primary mt-2">
            Thêm bài viết mới
        </a>
    </div>

    <!-- Bảng danh sách -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th width="5%">ID</th>
                        <th width="15%">Ảnh bìa</th>
                        <th width="35%">Tiêu đề</th>
                        <th width="15%">Danh mục</th>
                        <th width="30%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="Cover" style="width: 80px; height: 60px; object-fit: cover;" class="rounded border" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có ảnh</span>
                                    }
                                </td>
                                <td class="text-start fw-bold text-dark">@item.Title</td>
                                <td>@(item.Category != null ? item.Category.Name : "Không có")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white me-1">
                                        Xem
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm text-white me-1">
                                        Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?');">
                                        Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có bài viết nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>  