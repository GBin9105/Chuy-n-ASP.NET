@model CMS.Data.Entities.Post
@{
    ViewData["Title"] = "Thêm Bài Viết";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 col-md-10 mx-auto">
        <div class="card-header bg-white border-bottom pt-4 pb-3">
            <h4 class="font-weight-bold text-uppercase mb-0">Thêm Bài Viết Mới</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="row">
                    <div class="col-md-8 form-group mb-3">
                        <label class="fw-bold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="col-md-4 form-group mb-3">
                        <label class="fw-bold">Danh mục <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList" required>
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Ảnh bìa (Upload)</label>
                    <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                </div>

                <div class="form-group mb-4">
                    <label class="fw-bold">Nội dung chi tiết</label>
                    <textarea asp-for="Content" class="form-control" rows="8"></textarea>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-4 fw-bold">
                        <i class="bi bi-save"></i> Đăng Bài
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>