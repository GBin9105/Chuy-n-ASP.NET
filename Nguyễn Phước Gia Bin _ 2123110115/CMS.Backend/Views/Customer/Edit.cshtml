@model CMS.Data.Entities.Customer
@{
    ViewData["Title"] = "Sửa Khách hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid mt-4">
    <h2>Chỉnh Sửa Thông Tin Khách Hàng</h2>
    <hr />
    <form asp-action="Edit" method="post" class="mt-3" style="max-width: 600px;">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-bold">Họ và Tên</label>
            <input asp-for="FullName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold">Email</label>
            <input asp-for="Email" type="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-bold">Mật khẩu</label>
            <input asp-for="Password" type="text" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-bold">Số điện thoại</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label fw-bold">Địa chỉ</label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-warning fw-bold">Cập nhật</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Hủy</a>
    </form>
</div>